{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "1. Compile C++ Code",
            "command": "C:\\Strawberry\\c\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-I${workspaceFolder}/include",
                "${workspaceFolder}/src/*.cpp",
                "-o",
                "${workspaceFolder}/build/DungeonRPG.exe",
                "-lwinmm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "build"
        },
        {
            "label": "2. Copy Assets",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "robocopy \"${workspaceFolder}\\assets\" \"${workspaceFolder}\\build\\assets\" /E /NJH /NJS /NFL /NDL /R:1 /W:1 & if %errorlevel% leq 7 exit 0"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent"
            },
            "group": "build"
        },
        {
            "label": "Build (compile + copy assets)",
            "dependsOn": [
                "1. Compile C++ Code",
                "2. Copy Assets"
            ],
            "dependsOrder": "sequence",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Compiles the project and copies asset folders to the build directory."
        }
    ]
}
